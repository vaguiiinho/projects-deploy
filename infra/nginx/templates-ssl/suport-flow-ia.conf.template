server {
  listen 80;
  server_name ${SUPORT_HOST};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  server_name ${SUPORT_HOST};
  client_max_body_size 20m;

  ssl_certificate /etc/letsencrypt/live/suport-flow-ia.kangaroo-tech.net/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/suport-flow-ia.kangaroo-tech.net/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  location /api/ {
    proxy_pass http://suport-flow-ia-api:3001/api/;
    include /etc/nginx/includes/proxy.conf;
  }

  location / {
    proxy_pass http://suport-flow-ia-web:3000;
    include /etc/nginx/includes/proxy.conf;
  }

  location = /worker/health {
    proxy_pass http://worker:3002/health;
    include /etc/nginx/includes/proxy.conf;
  }
}

